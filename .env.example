# Copy to .env (gitignored).

# Curation (src/curate.py)
# Email for OpenAlex's "polite pool"; also sent to NCBI (PubMed) as the contact address.
OPENALEX_MAILTO=you@example.com
# Optional free key (openalex.org/settings/api). Without it, your IP shares a $0.10/day budget.
OPENALEX_API_KEY=

# LLM: any OpenAI-compatible API. Blank = local Ollama, llama3.2:3b, prompt v1. Hosted setup (Groq), plus your key:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_PROMPT_VERSION=v2
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_PROMPT_VERSION=
LLM_API_KEY=
LLM_EXTRA_PARAMS=
